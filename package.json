{
  "name": "onda-backend",
  "version": "1.0.0",
  "description": "Backend for Onda, a perps DEX on Hyperliquid.",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "serve": "node dist",
    "sweep": "npm run build && node dist/cron/sweeper.js",
    "sweep:dev": "tsx src/cron/sweeper.ts",
    "sync": "npm run build && node dist/cron/sync_wallets.js",
    "sync:dev": "tsx src/cron/sync_wallets.ts",
    "hl": "tsx src/cron/hl_balance.ts",
    "dev": "npm run build && npm run serve",
    "start": "node dist"
  },
  "keywords": [
    "onda-backend"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@privy-io/node": "^0.34.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "viem": "^2.56.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
