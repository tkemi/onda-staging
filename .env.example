 # Local Postgres. Create with: createdb -T template0 onda_dev
DATABASE_URL=postgresql://localhost:5432/onda_dev

# Secret for encrypting wallet private keys at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Svix signing key from Privy dashboard > Configuration > Webhooks
PRIVY_WEBHOOK_SIGNING_KEY=

# Privy dashboard > Settings
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Shared tokens for the partner trading-analysis websocket (/ws/trading-analysis).
# Format: comma-separated partner:token pairs, e.g. acme:abc123,globex:def456
# Give each partner their own token so we can tell deliveries apart.
# Generate one with: openssl rand -hex 32
TRADING_ANALYSIS_STREAM_TOKEN=

# Telegram bot that posts to private channels. The bot must be an ADMIN of each channel.
# TELEGRAM_BOT_TOKEN: from @BotFather (looks like 123456789:AA...).
# TELEGRAM_CHAT_ID: raw incoming partner signals channel (e.g. -1001234567890).
# TELEGRAM_SETUPS_CHAT_ID: processed, user-facing pushed-signal setups + lifecycle events.
#   Falls back to TELEGRAM_CHAT_ID when unset.
# TELEGRAM_ONDEMAND_CHAT_ID: on-demand (futures-plan) setups. No fallback — if unset, those
#   setups are stored in the DB but not posted anywhere.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SETUPS_CHAT_ID=
TELEGRAM_ONDEMAND_CHAT_ID=

# Partner on-demand analysis APIs (futures plan + spot zones).
# PARTNER_API_BASE: e.g. https://xxxx.supabase.co/functions/v1
# Client credentials are exchanged for a short-lived bearer at api-oauth-token.
PARTNER_API_BASE=
PARTNER_API_CLIENT_ID=
PARTNER_API_CLIENT_SECRET=
# Optional: static bearer override for quick tests (instead of client credentials)
PARTNER_API_TOKEN=
# Optional: which timeframe to pull futures plans for (default 4H)
PARTNER_FUTURES_TIMEFRAME=
# Optional: explicit symbol list for on-demand pulls (default: derived from HL markets)
ONDEMAND_SYMBOLS=
# Optional: max partner API calls per on-demand run (stays under their rate limit; default 40)
ONDEMAND_MAX_CALLS=
# Optional: delay between partner API calls in ms (default 500)
ONDEMAND_CALL_DELAY_MS=

# Monitor worker poll interval in ms (default 5000)
MONITOR_INTERVAL_MS=
